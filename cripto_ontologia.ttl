@prefix cripto: <http://unal.edu.co/cripto#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cripto:AlgoritmoCriptografico a rdfs:Class ;
    rdfs:label "Algoritmo criptográfico usado para proteger información mediante cifrado, firma, hash o intercambio de claves."@es .

cripto:AlgoritmoPostCuantico a rdfs:Class ;
    rdfs:label "Algoritmo criptográfico diseñado para resistir ataques realizados con computación cuántica."@es ;
    rdfs:subClassOf cripto:AlgoritmoCriptografico .

cripto:AlgoritmoVulnerable a rdfs:Class ;
    rdfs:label "Algoritmo criptográfico que presenta debilidades conocidas, obsolescencia o inseguridad práctica."@es ;
    rdfs:subClassOf cripto:AlgoritmoCriptografico .

cripto:CifradoAsimetrico a rdfs:Class ;
    rdfs:label "Algoritmo criptográfico que utiliza un par de claves, generalmente pública y privada."@es ;
    rdfs:subClassOf cripto:AlgoritmoCriptografico .

cripto:CifradoSimetrico a rdfs:Class ;
    rdfs:label "Algoritmo criptográfico que utiliza una clave compartida para cifrar y descifrar información."@es ;
    rdfs:subClassOf cripto:AlgoritmoCriptografico .

cripto:ContextoUso a rdfs:Class ;
    rdfs:label "Escenario, entorno o necesidad donde puede aplicarse una solución criptográfica."@es .

cripto:EstadoSeguridad a rdfs:Class ;
    rdfs:label "Categoría que representa el nivel o condición de seguridad de un algoritmo criptográfico."@es .

cripto:FuncionHash a rdfs:Class ;
    rdfs:label "Algoritmo que produce una huella digital de tamaño fijo a partir de datos de entrada."@es ;
    rdfs:subClassOf cripto:AlgoritmoCriptografico .

cripto:InfraestructuraCritica a rdfs:Class ;
    rdfs:label "Contexto de uso donde una falla de seguridad puede afectar servicios esenciales o sistemas de alto impacto."@es ;
    rdfs:subClassOf cripto:ContextoUso .

cripto:RecursoLimitado a rdfs:Class ;
    rdfs:label "Contexto de uso con restricciones importantes de memoria, energía o capacidad de procesamiento."@es ;
    rdfs:subClassOf cripto:ContextoUso .

cripto:BajaSeguridad a cripto:EstadoSeguridad ;
    rdfs:label "Baja seguridad"@es .

cripto:Central_Electrica a cripto:InfraestructuraCritica ;
    rdfs:label "Central eléctrica inteligente"@es ;
    cripto:requiereNivelSeguridad cripto:AltaSeguridad ;
    cripto:requiereTamanoClaveMinimo 256 ;
    cripto:tieneLimitacionGeneral "Impacto alto sobre servicios esenciales."@es ;
    cripto:tieneLimitacionTecnica "Requiere baja latencia para control industrial."@es ;
    cripto:usaAlgoritmoRecomendado cripto:AES_256 .

cripto:Control_Ferroviario a cripto:InfraestructuraCritica ;
    rdfs:label "Sistema de control ferroviario"@es ;
    cripto:requiereNivelSeguridad cripto:AltaSeguridad ;
    cripto:requiereTamanoClaveMinimo 256 ;
    cripto:tieneLimitacionGeneral "Fallas de integridad pueden causar accidentes graves."@es ;
    cripto:tieneLimitacionTecnica "Debe coexistir con protocolos industriales heredados."@es ;
    cripto:usaAlgoritmoRecomendado cripto:SHA_3 .

cripto:DES a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoVulnerable,
        cripto:CifradoSimetrico ;
    rdfs:label "DES - Estándar de Cifrado de Datos"@es ;
    cripto:añoDeCreacion "1977"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:SistemasHeredados ;
    cripto:esVulnerableA "Ataque de fuerza bruta por espacio de claves reducido."@es ;
    cripto:fueEstandarizadoPor "NBS / NIST"^^xsd:string ;
    cripto:requiereMemoria "Baja"^^xsd:string ;
    cripto:tieneLimitacionGeneral "No debe usarse para proteger información sensible actual."@es ;
    cripto:tieneLimitacionTecnica "Clave de 56 bits insuficiente para hardware moderno."@es ;
    cripto:tieneNivelSeguridad cripto:Vulnerable ;
    cripto:tieneVelocidadEjecucion "Alta"^^xsd:string ;
    cripto:utilizaClaveDeTamano 56 .

cripto:DiffieHellman a cripto:AlgoritmoCriptografico,
        cripto:CifradoAsimetrico ;
    rdfs:label "Diffie-Hellman"@es ;
    cripto:añoDeCreacion "1976"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:TransmisionTiempoReal ;
    cripto:fueEstandarizadoPor "IETF"^^xsd:string ;
    cripto:requiereMemoria "Media"^^xsd:string ;
    cripto:tieneLimitacionGeneral "No cifra mensajes directamente; sirve para intercambio de claves."@es ;
    cripto:tieneNivelSeguridad cripto:AltaSeguridad ;
    cripto:tieneRiesgoCondicional "Vulnerable a MitM si no se autentica el intercambio."@es ;
    cripto:tieneVelocidadEjecucion "Baja"^^xsd:string ;
    cripto:utilizaClaveDeTamano 2048 .

cripto:Dilithium a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoPostCuantico ;
    rdfs:label "CRYSTALS-Dilithium"@es ;
    cripto:añoDeCreacion "2024"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:FirmaDigital ;
    cripto:fueEstandarizadoPor "NIST FIPS 204"^^xsd:string ;
    cripto:requiereMemoria "Media"^^xsd:string ;
    cripto:tieneFortalezaSeguridad "Firma digital resistente a ataques cuánticos conocidos."@es ;
    cripto:tieneLimitacionTecnica "Firmas más grandes que ECDSA o RSA."@es ;
    cripto:tieneNivelSeguridad cripto:PostCuanticoSeguro ;
    cripto:tieneVelocidadEjecucion "Alta"^^xsd:string ;
    cripto:utilizaClaveDeTamano 2592 .

cripto:Falcon a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoPostCuantico ;
    rdfs:label "Falcon"@es ;
    cripto:añoDeCreacion "2024"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:DispositivosIoT ;
    cripto:fueEstandarizadoPor "NIST"^^xsd:string ;
    cripto:requiereMemoria "Baja"^^xsd:string ;
    cripto:tieneFortalezaSeguridad "Firmas compactas útiles cuando el ancho de banda es limitado."@es ;
    cripto:tieneLimitacionTecnica "Difícil de implementar correctamente en hardware limitado."@es ;
    cripto:tieneNivelSeguridad cripto:PostCuanticoSeguro ;
    cripto:tieneRiesgoCondicional "Implementación compleja por uso de aritmética de punto flotante."@es ;
    cripto:tieneVelocidadEjecucion "Alta"^^xsd:string ;
    cripto:utilizaClaveDeTamano 897 .

cripto:MD5 a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoVulnerable,
        cripto:FuncionHash ;
    rdfs:label "MD5"@es ;
    cripto:añoDeCreacion "1991"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:SistemasHeredados ;
    cripto:esVulnerableA "Colisiones criptográficas prácticas."@es ;
    cripto:fueEstandarizadoPor "IETF"^^xsd:string ;
    cripto:requiereMemoria "Baja"^^xsd:string ;
    cripto:tieneLimitacionGeneral "Criptográficamente roto para seguridad moderna."@es ;
    cripto:tieneNivelSeguridad cripto:Vulnerable ;
    cripto:tieneTamanoSalidaBits 128 ;
    cripto:tieneVelocidadEjecucion "Alta"^^xsd:string .

cripto:Marcapasos_Conectado a cripto:RecursoLimitado ;
    rdfs:label "Marcapasos conectado"@es ;
    cripto:requiereNivelSeguridad cripto:AltaSeguridad ;
    cripto:requiereTamanoClaveMinimo 128 ;
    cripto:tieneLimitacionGeneral "La duración de la batería es crítica."@es ;
    cripto:tieneLimitacionTecnica "Ciclos de CPU limitados para evitar consumo excesivo."@es ;
    cripto:usaAlgoritmoRecomendado cripto:AES_256 .

cripto:OntologiaCripto a dcmitype:Dataset ;
    dc:creator "Proyecto académico de sistema experto criptográfico"@es ;
    dc:description "Ontología RDF/RDFS para representar algoritmos criptográficos, estados de seguridad, contextos de uso, vulnerabilidades, riesgos condicionales y recomendaciones."@es ;
    dc:language "es"^^xsd:string ;
    dc:title "Ontología de algoritmos criptográficos y contextos de uso"@es .

cripto:Planta_Agua a cripto:InfraestructuraCritica ;
    rdfs:label "Planta de tratamiento de agua"@es ;
    cripto:requiereNivelSeguridad cripto:AltaSeguridad ;
    cripto:requiereTamanoClaveMinimo 256 ;
    cripto:tieneLimitacionGeneral "Difícil actualización de algoritmos en sitio."@es ;
    cripto:tieneLimitacionTecnica "Hardware industrial con ciclos de vida largos."@es ;
    cripto:usaAlgoritmoRecomendado cripto:RSA_4096 .

cripto:RC4 a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoVulnerable ;
    rdfs:label "RC4"@es ;
    cripto:añoDeCreacion "1987"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:SistemasHeredados ;
    cripto:esVulnerableA "Sesgos estadísticos en el flujo de claves."@es ;
    cripto:requiereMemoria "Baja"^^xsd:string ;
    cripto:tieneLimitacionGeneral "No recomendado para TLS moderno."@es ;
    cripto:tieneNivelSeguridad cripto:Vulnerable ;
    cripto:tieneVelocidadEjecucion "Alta"^^xsd:string ;
    cripto:utilizaClaveDeTamano 128 .

cripto:RSA_1024 a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoVulnerable ;
    rdfs:label "RSA con clave de 1024 bits"@es ;
    cripto:añoDeCreacion "1990"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:SistemasHeredados ;
    cripto:esVulnerableA "Tamaño de clave insuficiente para seguridad moderna."@es ;
    cripto:requiereMemoria "Media"^^xsd:string ;
    cripto:tieneLimitacionGeneral "No cumple recomendaciones modernas de seguridad."@es ;
    cripto:tieneNivelSeguridad cripto:Vulnerable ;
    cripto:tieneVelocidadEjecucion "Media"^^xsd:string ;
    cripto:utilizaClaveDeTamano 1024 .

cripto:RSA_2048 a cripto:AlgoritmoCriptografico,
        cripto:CifradoAsimetrico ;
    rdfs:label "RSA con clave de 2048 bits"@es ;
    cripto:añoDeCreacion "1977"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:FirmaDigital ;
    cripto:fueEstandarizadoPor "RSA Laboratories / IETF"^^xsd:string ;
    cripto:requiereMemoria "Media"^^xsd:string ;
    cripto:tieneLimitacionGeneral "Lento frente al cifrado simétrico."@es ;
    cripto:tieneNivelSeguridad cripto:AltaSeguridad ;
    cripto:tieneRiesgoCondicional "Es vulnerable a computación cuántica de gran escala mediante Shor."@es ;
    cripto:tieneVelocidadEjecucion "Baja"^^xsd:string ;
    cripto:utilizaClaveDeTamano 2048 .

cripto:Router_Legacy a cripto:RecursoLimitado ;
    rdfs:label "Router doméstico antiguo"@es ;
    cripto:requiereNivelSeguridad cripto:SeguridadMedia ;
    cripto:requiereTamanoClaveMinimo 128 ;
    cripto:tieneLimitacionGeneral "Dificultad para soportar protocolos modernos."@es ;
    cripto:tieneLimitacionTecnica "Memoria RAM y CPU limitadas."@es ;
    cripto:usaAlgoritmoRecomendado cripto:ChaCha20 .

cripto:SHA_1 a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoVulnerable,
        cripto:FuncionHash ;
    rdfs:label "SHA-1"@es ;
    cripto:añoDeCreacion "1995"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:SistemasHeredados ;
    cripto:esVulnerableA "Ataques de colisión prácticos."@es ;
    cripto:fueEstandarizadoPor "NIST"^^xsd:string ;
    cripto:requiereMemoria "Baja"^^xsd:string ;
    cripto:tieneLimitacionGeneral "No se recomienda para firmas digitales modernas."@es ;
    cripto:tieneNivelSeguridad cripto:Vulnerable ;
    cripto:tieneTamanoSalidaBits 160 ;
    cripto:tieneVelocidadEjecucion "Alta"^^xsd:string .

cripto:SHA_256 a cripto:AlgoritmoCriptografico,
        cripto:FuncionHash ;
    rdfs:label "SHA-256"@es ;
    cripto:añoDeCreacion "2001"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:AutenticacionUsuarios ;
    cripto:fueEstandarizadoPor "NIST"^^xsd:string ;
    cripto:requiereMemoria "Baja"^^xsd:string ;
    cripto:tieneLimitacionTecnica "Diseño basado en Merkle-Damgård."@es ;
    cripto:tieneNivelSeguridad cripto:AltaSeguridad ;
    cripto:tieneRiesgoCondicional "Puede sufrir ataques de extensión de longitud si se usa incorrectamente."@es ;
    cripto:tieneTamanoSalidaBits 256 ;
    cripto:tieneVelocidadEjecucion "Alta"^^xsd:string .

cripto:Satelite_Gob a cripto:InfraestructuraCritica ;
    rdfs:label "Satélite de comunicaciones gubernamental"@es ;
    cripto:requiereNivelSeguridad cripto:PostCuanticoSeguro ;
    cripto:requiereTamanoClaveMinimo 256 ;
    cripto:tieneLimitacionGeneral "Requiere protección de largo plazo frente a amenazas futuras."@es ;
    cripto:tieneLimitacionTecnica "No puede intervenirse físicamente luego del lanzamiento."@es ;
    cripto:usaAlgoritmoRecomendado cripto:Kyber .

cripto:SensorIoT_Temp a cripto:RecursoLimitado ;
    rdfs:label "Sensor IoT de temperatura"@es ;
    cripto:requiereNivelSeguridad cripto:AltaSeguridad ;
    cripto:requiereTamanoClaveMinimo 128 ;
    cripto:tieneLimitacionGeneral "No soporta algoritmos asimétricos pesados."@es ;
    cripto:tieneLimitacionTecnica "Batería limitada y CPU de baja potencia."@es ;
    cripto:usaAlgoritmoRecomendado cripto:ChaCha20 .

cripto:SmartCard_NFC a cripto:RecursoLimitado ;
    rdfs:label "Tarjeta inteligente NFC"@es ;
    cripto:requiereNivelSeguridad cripto:AltaSeguridad ;
    cripto:requiereTamanoClaveMinimo 128 ;
    cripto:tieneLimitacionGeneral "Exposición a ataques físicos y de canal lateral."@es ;
    cripto:tieneLimitacionTecnica "Memoria EEPROM reducida."@es ;
    cripto:usaAlgoritmoRecomendado cripto:ECC_256 .

cripto:SphincsPlus a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoPostCuantico ;
    rdfs:label "SPHINCS+"@es ;
    cripto:añoDeCreacion "2024"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:AlmacenamientoLargoPlazo ;
    cripto:fueEstandarizadoPor "NIST FIPS 205"^^xsd:string ;
    cripto:requiereMemoria "Alta"^^xsd:string ;
    cripto:tieneFortalezaSeguridad "Firma basada en hash, útil como alternativa conservadora a largo plazo."@es ;
    cripto:tieneLimitacionTecnica "Generación de firma computacionalmente costosa."@es ;
    cripto:tieneNivelSeguridad cripto:PostCuanticoSeguro ;
    cripto:tieneVelocidadEjecucion "Baja"^^xsd:string ;
    cripto:utilizaClaveDeTamano 32 .

cripto:TDES a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoVulnerable,
        cripto:CifradoSimetrico ;
    rdfs:label "Triple DES"@es ;
    cripto:añoDeCreacion "1998"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:SistemasHeredados ;
    cripto:esVulnerableA "Tamaño de bloque pequeño y riesgo en grandes volúmenes de datos."@es ;
    cripto:fueEstandarizadoPor "NIST"^^xsd:string ;
    cripto:requiereMemoria "Baja"^^xsd:string ;
    cripto:tieneLimitacionGeneral "Algoritmo heredado y menos eficiente que AES."@es ;
    cripto:tieneLimitacionTecnica "Tamaño de bloque de 64 bits."@es ;
    cripto:tieneNivelSeguridad cripto:Obsoleto ;
    cripto:tieneVelocidadEjecucion "Baja"^^xsd:string ;
    cripto:utilizaClaveDeTamano 168 .

cripto:añoDeCreacion a rdf:Property ;
    rdfs:label "Indica el año de creación, publicación o estandarización del algoritmo."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range xsd:gYear .

cripto:esRecomendadoPara a rdf:Property ;
    rdfs:label "Relaciona un algoritmo criptográfico con un contexto de uso donde resulta adecuado."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range cripto:ContextoUso .

cripto:esVulnerableA a rdf:Property ;
    rdfs:label "Describe una vulnerabilidad real o debilidad conocida de un algoritmo."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range rdfs:Literal .

cripto:fueEstandarizadoPor a rdf:Property ;
    rdfs:label "Indica la organización, entidad o estándar asociado al algoritmo."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:publisher .

cripto:requiereMemoria a rdf:Property ;
    rdfs:label "Indica una categoría cualitativa de uso de memoria: Alta, Media o Baja."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range xsd:string .

cripto:requiereNivelSeguridad a rdf:Property ;
    rdfs:label "Indica el nivel de seguridad requerido por un contexto de uso."@es ;
    rdfs:domain cripto:ContextoUso ;
    rdfs:range cripto:EstadoSeguridad .

cripto:requiereTamanoClaveMinimo a rdf:Property ;
    rdfs:label "Indica el tamaño mínimo de clave requerido por un contexto de uso, en bits."@es ;
    rdfs:domain cripto:ContextoUso ;
    rdfs:range xsd:integer .

cripto:tieneFortalezaSeguridad a rdf:Property ;
    rdfs:label "Describe una fortaleza de seguridad relevante del algoritmo."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range rdfs:Literal .

cripto:tieneLimitacionTecnica a rdf:Property ;
    rdfs:label "Describe una limitación técnica específica del algoritmo o contexto."@es ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf cripto:tieneLimitacionGeneral .

cripto:tieneNivelSeguridad a rdf:Property ;
    rdfs:label "Relaciona un algoritmo criptográfico con su estado o nivel de seguridad."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range cripto:EstadoSeguridad .

cripto:tieneRiesgoCondicional a rdf:Property ;
    rdfs:label "Describe un riesgo que aparece solo si el algoritmo se implementa o usa incorrectamente."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range rdfs:Literal .

cripto:tieneTamanoSalidaBits a rdf:Property ;
    rdfs:label "Indica el tamaño de salida en bits para funciones hash o firmas."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range xsd:integer .

cripto:tieneVelocidadEjecucion a rdf:Property ;
    rdfs:label "Indica una categoría cualitativa de velocidad de ejecución: Alta, Media o Baja."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range xsd:string .

cripto:usaAlgoritmoRecomendado a rdf:Property ;
    rdfs:label "Relaciona un contexto de uso con un algoritmo recomendado para ese escenario."@es ;
    rdfs:domain cripto:ContextoUso ;
    rdfs:range cripto:AlgoritmoCriptografico .

cripto:utilizaClaveDeTamano a rdf:Property ;
    rdfs:label "Indica el tamaño de clave utilizado o recomendado por un algoritmo, en bits."@es ;
    rdfs:domain cripto:AlgoritmoCriptografico ;
    rdfs:range xsd:integer .

cripto:AutenticacionUsuarios a cripto:ContextoUso ;
    rdfs:label "Autenticación de usuarios"@es .

cripto:BancaEnLinea a cripto:ContextoUso ;
    rdfs:label "Banca en línea"@es .

cripto:DispositivosIoT a cripto:ContextoUso ;
    rdfs:label "Dispositivos IoT"@es .

cripto:DispositivosMoviles a cripto:ContextoUso ;
    rdfs:label "Dispositivos móviles"@es .

cripto:ECC_256 a cripto:AlgoritmoCriptografico,
        cripto:CifradoAsimetrico ;
    rdfs:label "Criptografía de Curva Elíptica de 256 bits"@es ;
    cripto:añoDeCreacion "1985"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:Blockchain ;
    cripto:fueEstandarizadoPor "NIST / SECG"^^xsd:string ;
    cripto:requiereMemoria "Baja"^^xsd:string ;
    cripto:tieneLimitacionTecnica "La seguridad depende de la curva elegida."@es ;
    cripto:tieneNivelSeguridad cripto:AltaSeguridad ;
    cripto:tieneRiesgoCondicional "Puede sufrir ataques de canal lateral si la implementación no está protegida."@es ;
    cripto:tieneVelocidadEjecucion "Media"^^xsd:string ;
    cripto:utilizaClaveDeTamano 256 .

cripto:Kyber a cripto:AlgoritmoCriptografico,
        cripto:AlgoritmoPostCuantico ;
    rdfs:label "CRYSTALS-Kyber"@es ;
    cripto:añoDeCreacion "2024"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:InfraestructuraCritica ;
    cripto:fueEstandarizadoPor "NIST FIPS 203"^^xsd:string ;
    cripto:requiereMemoria "Media"^^xsd:string ;
    cripto:tieneFortalezaSeguridad "Diseñado para intercambio de claves resistente a amenazas cuánticas."@es ;
    cripto:tieneLimitacionTecnica "Basado en problemas de redes/lattices."@es ;
    cripto:tieneNivelSeguridad cripto:PostCuanticoSeguro ;
    cripto:tieneRiesgoCondicional "Puede sufrir ataques de canal lateral en implementaciones físicas."@es ;
    cripto:tieneVelocidadEjecucion "Alta"^^xsd:string ;
    cripto:utilizaClaveDeTamano 1632 .

cripto:Obsoleto a cripto:EstadoSeguridad ;
    rdfs:label "Obsoleto"@es .

cripto:RSA_4096 a cripto:AlgoritmoCriptografico,
        cripto:CifradoAsimetrico ;
    rdfs:label "RSA con clave de 4096 bits"@es ;
    cripto:añoDeCreacion "2002"^^xsd:gYear ;
    cripto:esRecomendadoPara cripto:AlmacenamientoLargoPlazo ;
    cripto:fueEstandarizadoPor "NIST / BSI"^^xsd:string ;
    cripto:requiereMemoria "Alta"^^xsd:string ;
    cripto:tieneLimitacionTecnica "Descifrado y firma más costosos que RSA-2048."@es ;
    cripto:tieneNivelSeguridad cripto:AltaSeguridad ;
    cripto:tieneRiesgoCondicional "No es post-cuántico; vulnerable ante computadores cuánticos suficientemente grandes."@es ;
    cripto:tieneVelocidadEjecucion "Baja"^^xsd:string ;
    cripto:utilizaClaveDeTamano 4096 .

cripto:SHA_3 a cripto:AlgoritmoCriptografico,
        cripto:FuncionHash ;
    rdfs:label "SHA-3"@es ;
    cripto:añoDeCreacion "2015"^^xsd:gYear ;
